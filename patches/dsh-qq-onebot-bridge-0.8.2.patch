+/** Typed use of the pinned bridge's patched transport export; raw frames remain untrusted. */
+import { EventEmitter } from 'node:events'
+interface Socket { readonly readyState: number; readonly OPEN: number }
+export function parseMessage(message: unknown, botQq: number): { text: string }
+export class OneBotServer extends EventEmitter {
+  constructor(config: { host: string; port: number; accessToken: string; botQq: number; maxFrameBytes: number; actionTimeoutMs: number },
+    logger: { info(message: string): void; warn(message: string): void; error(message: string): void })
+  start(options: { timeoutMs: number }): Promise<{ ok: boolean; code?: string; reason?: string }>
+  connect(url: string, options: { timeoutMs: number; signal: AbortSignal }): Promise<{ ok: boolean; code?: string; reason?: string }>
+  stop(): Promise<void>
+  address(): { address: string; port: number } | string | null
+  getGroupInfo(socket: Socket, groupId: number, noCache?: boolean): Promise<unknown>
+  sendSegments(socket: Socket, messageType: 'group' | 'private', targetId: number, segments: Array<{ type: string; data: Record<string, unknown> }>): Promise<unknown>
+  callRaw(socket: Socket, action: string, params?: Record<string, unknown>): Promise<unknown>
+  getMsg(socket: Socket, messageId: string): Promise<unknown>
+  sendText(socket: Socket, messageType: 'group' | 'private', targetId: number, text: string): Promise<unknown>
+}
