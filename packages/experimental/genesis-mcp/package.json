{
  "name": "@deepseek-ai/dsh-experimental-genesis-mcp",
  "version": "0.2.2-rc.1",
  "description": "Operator-managed MCP services and official registry installation.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
