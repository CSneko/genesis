{
  "name": "@deepseek-ai/dsh-experimental-genesis-bili-humanism",
  "version": "0.2.2-rc.1",
  "description": "Bilibili reading and shared Genesis viewing notes with explicit legacy migration.",
  "type": "module",
  "main": "lib/index.js",
